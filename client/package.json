{
  "name": "cnd102-helper-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "bulma": "^1.0.4",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "react-scripts": "^5.0.1",
    "sass": "^1.107.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build-bulma": "sass --load-path=node_modules my-bulma-project.scss src/my-bulma-project.css",
    "watch-bulma": "npm run build-bulma -- --watch",
    "start": "concurrently -k \"npm:watch-bulma\" \"react-scripts start\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
